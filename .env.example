# 本番デプロイ用の環境変数サンプル。実際の .env にコピーして値を設定する。
# .env は絶対にGit等へコミットしないこと。

# --- 必須 ---
# python -c "import secrets; print(secrets.token_urlsafe(50))" で生成
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# 本番は 0（開発時のみ 1）
DJANGO_DEBUG=0

# サービスを公開するドメイン（カンマ区切り）
DJANGO_ALLOWED_HOSTS=api.example.com

# TLS(HTTPS)終端の背後で運用するとき 1（HTTPS強制・HSTS等が有効化）
DJANGO_SECURE=1

# Web版フロントを別オリジンで配信する場合のみ設定（カンマ区切り）。
# モバイルAPKだけなら不要。例: https://app.example.com
DJANGO_CORS_ORIGINS=

# --- PostgreSQL（設定するとSQLiteの代わりに使用）---
POSTGRES_DB=deadline
POSTGRES_USER=deadline
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
