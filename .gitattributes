# Linuxサーバーで動くため、テキストはLFに正規化する（Procfile等の改行崩れ防止）
* text=auto eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.apk binary
*.keystore binary
*.jar binary
*.pdf binary
# Flutter Web のビルド生成物（バイナリ）
*.wasm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.bin binary
*.data binary
*.symbols binary

# webapp/ は flutter build web の生成物。GitHubの言語統計・差分から除外する
# （実際に書いたコードは Python(Django) と Dart(Flutter)）
webapp/** linguist-generated=true
